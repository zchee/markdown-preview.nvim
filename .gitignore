# markdown-preview.nvim project generated files to ignore
#  If you want to ignore files created by your editor/tools,
#  please consider a global .gitignore https://docs.github.com/en/get-started/git-basics/ignoring-files.
#  PLEASE DO NOT open a pull request to add something created by your editor or tools

# github/gitignore/Lua
# Compiled Lua sources
luac.out

# luarocks build files
*.src.rock
*.zip
*.tar.gz

# Object files
*.o
*.os
*.ko
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
*.def
*.exp

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# markdown-preview.nvim development
# Python bytecode from the headless-Chrome checks under tests/browser
__pycache__/
# Test dependencies checked out by CI (plenary.nvim)
/.deps/
# Generated by :helptags
/doc/tags

# Image fixtures for the browser checks; the user-level ignore drops *.png
!/tests/fixtures/images/*.png
