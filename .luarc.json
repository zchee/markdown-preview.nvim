{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "LuaJIT",
  "runtime.path": [
    "lua/?.lua",
    "lua/?/init.lua"
  ],
  "diagnostics.globals": [
    "vim",
    "describe",
    "it",
    "before_each",
    "after_each",
    "assert"
  ],
  "workspace.library": [
    "$VIMRUNTIME/lua",
    "${3rd}/busted/library"
  ],
  "workspace.checkThirdParty": false
}
